{
  "name": "crunchyroll-watchparty",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "build:css": "node scripts/build-css.js",
    "watch:css:content": "node scripts/build-css.js content --watch",
    "watch:css:host": "node scripts/build-css.js host --watch",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "package:extension": "node scripts/package-extension.js",
    "prepackage:extension": "npm run build:css",
    "verify": "npm run build:css && npm run check && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/cli": "4.3.5",
    "tailwindcss": "4.3.5"
  }
}
