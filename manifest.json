{
  "manifest_version": 3,
  "name": "WatchParty — Watch together",
  "description": "Your people, the same moment. Synced playback, room invites, and side-panel chat. Currently supports Crunchyroll.",
  "version": "2.0.4",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "sidePanel"],
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "host_permissions": ["https://www.crunchyroll.com/*", "https://beta.crunchyroll.com/*", "https://static.crunchyroll.com/*"],
  "action": {
    "default_title": "WatchParty",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.crunchyroll.com/*", "https://beta.crunchyroll.com/*", "https://static.crunchyroll.com/vilos-v2/*"],
      "js": ["content/player-controls-main.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.crunchyroll.com/*", "https://beta.crunchyroll.com/*"],
      "js": [
        "content/shared.js",
        "content/player-controls.js",
        "content/player-bridge.js",
        "content/ui-view.js",
        "content/ui-host.js",
        "content/side-panel.js",
        "content/ui.js",
        "content/network.js",
        "content/player-sync.js",
        "content/invite.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://static.crunchyroll.com/vilos-v2/*"],
      "js": ["content/shared.js", "content/player-controls.js", "content/ui-view.js", "content/ui-host.js", "content/player-frame.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["host.css"],
    "matches": ["https://www.crunchyroll.com/*", "https://beta.crunchyroll.com/*", "https://static.crunchyroll.com/*"]
  }]
}
